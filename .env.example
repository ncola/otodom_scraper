DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_password
DB_SSLMODE=require

CITY=katowice

# Optional escape hatch: set only if you want to bypass the URL builder in config/cities.py
# (e.g. custom filters, a specific district). Skips startup URL validation.
# SEARCH_URL=https://www.otodom.pl/pl/wyniki/sprzedaz/mieszkanie/slaskie/katowice/katowice/katowice?viewType=listing&by=LATEST&direction=DESC&limit=72

# "full" runs a complete sync (all pages + deletion check), "latest" only checks the first page(s) for new offers
SCRAPE_MODE=full
LATEST_MAX_PAGES=2